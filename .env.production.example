# ============================================================
#  Odysseus Network — .env de PRODUCTION (lancement réel)
#  Copier en .env :  cp .env.production.example .env
#  Remplir chaque <…>. Ne JAMAIS committer le .env réel.
#
#  Convention domaines (adapter, cf. deploy/Caddyfile.example) :
#    site   https://odysseus.exemple.com
#    IA     https://app.odysseus.exemple.com
#    API    https://api.odysseus.exemple.com
#    payer  https://pay.odysseus.exemple.com
# ============================================================

# ---------- Fondateur ----------
FOUNDER_WALLET=<0x_adresse_fondateur>            # 10% des tokens + 10% des revenus à vie
STAFF_TREASURY_WALLET=<0x_tresorerie_equipe>     # 10% des revenus
FOUNDER_STORAGE_GB=200
# Modèle local pour les jobs améliorateur/voteur du mineur fondateur :
FOUNDER_MODEL_ENDPOINT=http://host.docker.internal:11434/v1
FOUNDER_MODEL_NAME=llama3.1

# ---------- Chaîne (Base mainnet par défaut) ----------
# USDC natif (Circle) sur Base : 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# -> vérifier sur https://www.circle.com/usdc avant déploiement, puis reporter
#    la même adresse dans web/assets/config.js si vous changez de chaîne.
RPC_URL=https://mainnet.base.org
REVENUE_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Renseignés PAR le déploiement (npm run deploy) :
ODY_TOKEN_ADDRESS=
REWARDS_DISTRIBUTOR_ADDRESS=
DIVIDEND_VAULT_ADDRESS=

# ---------- Clés opérationnelles ----------
# Oracle : clé CHAUDE dédiée, financée du strict minimum de gas (elle ne peut
# que publier des époques — elle ne touche ni fonds ni paramètres).
ORACLE_PRIVATE_KEY=<0x_cle_oracle>
ORACLE_POLL_SECONDS=300
# Déployeur / trésorerie : NE PAS stocker ici — exporter dans le shell au
# moment de l'usage uniquement (deploy.js, distribute-revenue.js) :
#   export DEPLOYER_PRIVATE_KEY=…   export TREASURY_PRIVATE_KEY=…
# Ownership des contrats : multisig via TRANSFER_OWNERSHIP_TO au déploiement.

# ---------- Coordinateur ----------
COORDINATOR_ADMIN_TOKEN=<token_long_aleatoire>   # openssl rand -hex 24
EPOCH_SECONDS=86400
GPU_POOL_BPS=7000
STORAGE_REPLICATION=3
EVOLUTION_VOTE_QUORUM=3
COORDINATOR_BIND=127.0.0.1
COORDINATOR_PORT=9000
CORS_ALLOW_ORIGINS=https://odysseus.exemple.com

# ---------- Paiements (Stripe LIVE) ----------
PAYMENTS_MODE=stripe
PAYMENTS_ADMIN_TOKEN=<token_long_aleatoire>
PAYMENTS_BIND=127.0.0.1
PAYMENTS_PORT=9100
PAYMENTS_PUBLIC_URL=https://pay.odysseus.exemple.com
SITE_URL=https://odysseus.exemple.com
STRIPE_SECRET_KEY=<sk_live_…>
STRIPE_PRICE_ID=<price_…>                        # produit "Abonnement Odysseus"
STRIPE_WEBHOOK_SECRET=<whsec_…>                  # endpoint /api/stripe/webhook

# ---------- Site public ----------
WEB_BIND=127.0.0.1
WEB_PORT=8088

# ---------- Cœur IA ----------
APP_BIND=127.0.0.1
APP_PORT=7000
AUTH_ENABLED=true
LOCALHOST_BYPASS=false
SECURE_COOKIES=true                              # true : on est derrière HTTPS
ALLOWED_ORIGINS=https://app.odysseus.exemple.com
ODYSSEUS_ADMIN_USER=admin
# GPU NVIDIA pour le cœur IA :
# COMPOSE_FILE=docker-compose.yml:ai/docker/gpu.nvidia.yml
