# ============================================================
#  AQL Network — PRODUCTION .env (coordinator server)
#  Copy to .env:  cp .env.production.example .env
#  Fill in every <…>. NEVER commit the real .env.
#
#  The website is published on Vercel (vercel.json); this file configures the
#  server that runs the coordinator behind HTTPS (deploy/Caddyfile.example).
# ============================================================

# ---------- Chain (Ethereum mainnet) ----------
RPC_URL=<ethereum_mainnet_rpc_url>
# USDT (Tether) on Ethereum — double-check on tether.to before use.
USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
# Provided BY the deployment (npm run deploy):
AQL_TOKEN_ADDRESS=
AQL_STAKING_ADDRESS=
AQL_NETWORK_ADDRESS=
# Start of epoch 0: MUST match the GENESIS_TS printed by the deployment.
GENESIS_TS=
# Deployment block: payments are read starting from this block.
CHAIN_START_BLOCK=<deployment_block>
CHAIN_CONFIRMATIONS=12

# ---------- Coordinator ----------
COORDINATOR_ADMIN_TOKEN=<long_random_token>      # openssl rand -hex 24
NETWORK_MODEL=qwen2.5:7b-instruct
COORDINATOR_BIND=127.0.0.1
COORDINATOR_PORT=9000
# Website domain (Vercel or a custom domain):
CORS_ALLOW_ORIGINS=https://<your-domain>
PRICE_START_MICRO=2000000
REQUESTS_PER_MINUTE=30
VERIFY_SAMPLE_RATE=0.05
BENCH_INTERVAL_SECONDS=7200
BENCH_REFERENCES=[]

# ---------- Oracle (one instance per operator, on THEIR OWN machine) ----------
# Dedicated hot key, funded with the bare minimum of gas: it can only vote
# on epochs, never touch funds.
ORACLE_PRIVATE_KEY=<0x_key_of_this_oracle>
ORACLE_POLL_SECONDS=300
# Coordinator address as seen by the oracle (on the operator's machine):
# COORDINATOR_URL=https://api.<your-domain>

# ---------- Your mining nodes (miner profile, optional) ----------
MINER_WALLET=<0x_your_address>
MINER_STORAGE_GB=200
