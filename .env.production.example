# ============================================================
#  AQL Network — .env de PRODUCTION (serveur du coordinateur)
#  Copier en .env :  cp .env.production.example .env
#  Remplir chaque <…>. Ne JAMAIS committer le .env réel.
#
#  Le site est publié sur Vercel (vercel.json) ; ce fichier configure le
#  serveur qui fait tourner le coordinateur derrière HTTPS (deploy/Caddyfile.example).
# ============================================================

# ---------- Chaîne (Ethereum mainnet) ----------
RPC_URL=<url_rpc_ethereum_mainnet>
# USDT (Tether) sur Ethereum — revérifier sur tether.to avant usage.
USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
# Renseignés PAR le déploiement (npm run deploy) :
AQL_TOKEN_ADDRESS=
AQL_STAKING_ADDRESS=
AQL_NETWORK_ADDRESS=
# Début de l'époque 0 : DOIT être identique au GENESIS_TS affiché par le déploiement.
GENESIS_TS=
# Bloc du déploiement : la lecture des paiements commence là.
CHAIN_START_BLOCK=<bloc_du_deploiement>
CHAIN_CONFIRMATIONS=12

# ---------- Coordinateur ----------
COORDINATOR_ADMIN_TOKEN=<token_long_aleatoire>   # openssl rand -hex 24
NETWORK_MODEL=qwen2.5:7b-instruct
COORDINATOR_BIND=127.0.0.1
COORDINATOR_PORT=9000
# Domaine du site (Vercel ou domaine personnalisé) :
CORS_ALLOW_ORIGINS=https://<votre-domaine>
PRICE_START_MICRO=2000000
REQUESTS_PER_MINUTE=30
VERIFY_SAMPLE_RATE=0.05
BENCH_INTERVAL_SECONDS=7200
BENCH_REFERENCES=[]

# ---------- Oracle (une instance par opérateur, sur SA machine) ----------
# Clé chaude dédiée, financée du strict minimum de gas : elle ne peut que voter
# des époques, jamais toucher aux fonds.
ORACLE_PRIVATE_KEY=<0x_cle_de_cet_oracle>
ORACLE_POLL_SECONDS=300
# Adresse du coordinateur vue par l'oracle (machine de l'opérateur) :
# COORDINATOR_URL=https://api.<votre-domaine>

# ---------- Vos nœuds de minage (profil miner, optionnel) ----------
MINER_WALLET=<0x_votre_adresse>
MINER_STORAGE_GB=200
