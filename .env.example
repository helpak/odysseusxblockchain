# ============================================================
#  AQL Network — local configuration / testing (docker-compose.yml)
#  Copy to .env:   cp .env.example .env
#  Production: start from .env.production.example.
#  NEVER commit the real .env.
# ============================================================

# ---------- Your mining nodes (miner profile) ----------
# Your public EVM address (never the private key): receives your mining earnings.
MINER_WALLET=
MINER_STORAGE_GB=50
# Model server for the GPU miner: by default, the ollama service of the miner profile.
# MINER_MODEL_ENDPOINT=http://ollama:11434/v1

# ---------- Coordinator ----------
# Token for the admin routes. Empty => generated on first start
# (docker compose logs coordinator).
COORDINATOR_ADMIN_TOKEN=
# Model served by the WHOLE network (a permissive license is recommended).
NETWORK_MODEL=qwen2.5:7b-instruct
COORDINATOR_BIND=127.0.0.1
COORDINATOR_PORT=9000
CORS_ALLOW_ORIGINS=*
# Starting price: micro-USDT per million tokens (2,000,000 = 2 USDT).
PRICE_START_MICRO=2000000
REQUESTS_PER_MINUTE=30
VERIFY_SAMPLE_RATE=0.05
BENCH_INTERVAL_SECONDS=7200
# Benchmark reference models (optional), OpenAI-compatible APIs:
# BENCH_REFERENCES=[{"name":"Reference A","url":"https://api.example.com/v1","model":"x","key_env":"REF_A_KEY"}]
BENCH_REFERENCES=[]

# ---------- Chain and contracts (filled in after `cd contracts && npm run deploy`) ----------
# Also copy the addresses into web/assets/config.js.
# Ethereum testnet (Sepolia) for testing; Ethereum mainnet in production.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
AQL_TOKEN_ADDRESS=
AQL_STAKING_ADDRESS=
AQL_NETWORK_ADDRESS=
USDT_ADDRESS=
# Start of epoch 0: MUST match the GENESIS_TS printed by the deployment.
GENESIS_TS=
# Deployment block: payments are read starting from this block.
CHAIN_START_BLOCK=0
CHAIN_CONFIRMATIONS=3
# Deployment keys: export them in the shell when you need them, never here.
# DEPLOYER_PRIVATE_KEY=

# ---------- Oracle (oracle profile) ----------
# The key of THIS oracle (each operator has their own).
ORACLE_PRIVATE_KEY=
ORACLE_POLL_SECONDS=300
# Coordinator address as seen by the oracle (on the operator's machine):
# COORDINATOR_URL=https://api.<your-domain>

# ---------- Public website (local testing; in production: Vercel) ----------
WEB_BIND=127.0.0.1
WEB_PORT=8088

# ---------- Odysseus workspace (workspace profile, optional) ----------
# Full list of options in ai/.env.example.
APP_BIND=127.0.0.1
APP_PORT=7000
AUTH_ENABLED=true
LOCALHOST_BYPASS=false
SECURE_COOKIES=false
