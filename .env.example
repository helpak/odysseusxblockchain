# ============================================================
#  Odysseus Network — configuration racine (docker-compose.yml)
#  Copier en .env :   cp .env.example .env
#  Ne JAMAIS committer le .env réel.
# ============================================================

# ---------- Fondateur ----------
# Votre adresse EVM publique (jamais la clé privée ici) :
# reçoit 10 % des tokens au déploiement, 10 % des revenus à vie,
# et les récompenses de vos premiers nœuds (profil founder).
FOUNDER_WALLET=
# Trésorerie de l'équipe (10 % des revenus). Peut être = FOUNDER_WALLET au début.
STAFF_TREASURY_WALLET=
# Espace disque offert par votre premier nœud de stockage (Go).
FOUNDER_STORAGE_GB=50
# Optionnel : modèle local (Ollama…) pour que votre mineur GPU fasse les jobs
# améliorateur/voteur. Ex. : http://host.docker.internal:11434/v1
FOUNDER_MODEL_ENDPOINT=
FOUNDER_MODEL_NAME=llama3.1

# ---------- Coordinateur ----------
# Jeton des routes admin (règlement d'époque, archivage). Vide => généré au
# premier démarrage et affiché dans : docker compose logs coordinator
COORDINATOR_ADMIN_TOKEN=
# 1 époque = 86400 s (1 jour) en production. Réduire (ex. 300) pour tester.
EPOCH_SECONDS=86400
# Répartition de la récompense d'époque : 7000 = 70 % GPU / 30 % stockage.
GPU_POOL_BPS=7000
STORAGE_REPLICATION=3
EVOLUTION_VOTE_QUORUM=3
COORDINATOR_BIND=127.0.0.1
COORDINATOR_PORT=9000
# En production, restreindre au domaine du site, ex. https://odysseus.exemple.com
CORS_ALLOW_ORIGINS=*

# ---------- Contrats (remplis après `cd contracts && npm run deploy`) ----------
# Reporter aussi ces adresses dans web/assets/config.js.
RPC_URL=https://sepolia.base.org
ODY_TOKEN_ADDRESS=
REWARDS_DISTRIBUTOR_ADDRESS=
DIVIDEND_VAULT_ADDRESS=
REVENUE_TOKEN_ADDRESS=
# Clés utilisées UNIQUEMENT par les scripts contracts/ en local — jamais par
# les conteneurs. Préférer les exporter dans le shell plutôt que les écrire ici.
# DEPLOYER_PRIVATE_KEY=
# ORACLE_PRIVATE_KEY=
# TREASURY_PRIVATE_KEY=

# ---------- Site public ----------
WEB_BIND=127.0.0.1
WEB_PORT=8088

# ---------- Cœur IA (dossier ai/ — liste complète dans ai/.env.example) ----------
APP_BIND=127.0.0.1
APP_PORT=7000
AUTH_ENABLED=true
LOCALHOST_BYPASS=false
SECURE_COOKIES=false
# LLM_HOST=localhost
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=
# GPU pour le cœur IA (NVIDIA) :
# COMPOSE_FILE=docker-compose.yml:ai/docker/gpu.nvidia.yml
