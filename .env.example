# ============================================================
#  AQL Network — configuration locale / essais (docker-compose.yml)
#  Copier en .env :   cp .env.example .env
#  Production : partir de .env.production.example.
#  Ne JAMAIS committer le .env réel.
# ============================================================

# ---------- Vos nœuds de minage (profil miner) ----------
# Votre adresse EVM publique (jamais la clé privée) : reçoit vos gains de minage.
MINER_WALLET=
MINER_STORAGE_GB=50
# Serveur de modèle du mineur GPU : par défaut le service ollama du profil miner.
# MINER_MODEL_ENDPOINT=http://ollama:11434/v1

# ---------- Coordinateur ----------
# Jeton des routes admin. Vide => généré au premier démarrage
# (docker compose logs coordinator).
COORDINATOR_ADMIN_TOKEN=
# Modèle servi par TOUT le réseau (licence permissive recommandée).
NETWORK_MODEL=qwen2.5:7b-instruct
COORDINATOR_BIND=127.0.0.1
COORDINATOR_PORT=9000
CORS_ALLOW_ORIGINS=*
# Prix de départ : micro-USDT par million de tokens (2 000 000 = 2 USDT).
PRICE_START_MICRO=2000000
REQUESTS_PER_MINUTE=30
VERIFY_SAMPLE_RATE=0.05
BENCH_INTERVAL_SECONDS=7200
# Modèles de référence du benchmark (optionnel), API compatibles OpenAI :
# BENCH_REFERENCES=[{"name":"Référence A","url":"https://api.exemple.com/v1","model":"x","key_env":"REF_A_KEY"}]
BENCH_REFERENCES=[]

# ---------- Chaîne et contrats (remplis après `cd contracts && npm run deploy`) ----------
# Reporter aussi les adresses dans web/assets/config.js.
# Testnet Ethereum (Sepolia) pour les essais ; mainnet Ethereum en production.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
AQL_TOKEN_ADDRESS=
AQL_STAKING_ADDRESS=
AQL_NETWORK_ADDRESS=
USDT_ADDRESS=
# Début de l'époque 0 : DOIT être identique au GENESIS_TS affiché par le déploiement.
GENESIS_TS=
# Bloc du déploiement : la lecture des paiements commence là.
CHAIN_START_BLOCK=0
CHAIN_CONFIRMATIONS=3
# Clés de déploiement : à exporter dans le shell au moment de l'usage, jamais ici.
# DEPLOYER_PRIVATE_KEY=

# ---------- Oracle (profil oracle) ----------
# La clé de CET oracle (chaque opérateur a la sienne).
ORACLE_PRIVATE_KEY=
ORACLE_POLL_SECONDS=300
# Adresse du coordinateur vue par l'oracle (machine de l'opérateur) :
# COORDINATOR_URL=https://api.<votre-domaine>

# ---------- Site public (essais locaux ; en production : Vercel) ----------
WEB_BIND=127.0.0.1
WEB_PORT=8088

# ---------- Espace de travail Odysseus (profil workspace, optionnel) ----------
# Liste complète des options dans ai/.env.example.
APP_BIND=127.0.0.1
APP_PORT=7000
AUTH_ENABLED=true
LOCALHOST_BYPASS=false
SECURE_COOKIES=false
