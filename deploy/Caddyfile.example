# HTTPS reverse proxy for the AQL coordinator — Caddy (automatic certificates).
# The website is published on Vercel; this server only exposes the coordinator API.
#   sudo cp deploy/Caddyfile.example /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# The coordinator stays bound to 127.0.0.1 (the docker-compose default): only Caddy
# is exposed to the Internet, over HTTPS.

api.example.com {
	reverse_proxy 127.0.0.1:9000 {
		# AI requests and miners' long polling can last up to a few minutes.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Optional: the Odysseus workspace (workspace profile), with
# AUTH_ENABLED=true and SECURE_COOKIES=true in .env.
# app.example.com {
# 	reverse_proxy 127.0.0.1:7000
# 	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
# }
